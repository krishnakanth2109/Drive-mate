{
  "expo": {
    "name": "RiderApp",
    "slug": "RiderApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.riderapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.riderapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDOMtmUqwZCLcEHSGQI4WpBLnvBiEPmX2E"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "d20e33f7-26e7-42f6-aec7-5ef824b8c272"
      }
    },
    "owner": "krishnakanth21",
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-font"
    ]
  }
}
