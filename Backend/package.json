{
  "name": "ride-backend",
  "version": "1.0.0",
  "description": "DriveMate Backend with TypeScript, Express, Prisma ORM, and Neon PostgreSQL",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prestart": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "migrate:data": "tsx scripts/migrateMongoToPostgres.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "redis": "^6.2.1",
    "socket.io": "^4.7.5",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
