generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// CUSTOMER & PASSENGER MODEL
// =========================================================================

model Customer {
  id                  String          @id
  name                String
  email               String          @unique
  phone               String
  password            String?
  role                String          @default("customer")
  walletBalance       Decimal         @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  coinBalance         Int             @default(0) @map("coin_balance")
  powerPassActive     Boolean         @default(false) @map("power_pass_active")
  powerPassPlan       String?         @map("power_pass_plan")
  powerPassValidUntil DateTime?       @map("power_pass_valid_until")
  firstName           String?         @map("first_name")
  lastName            String?         @map("last_name")
  profession          String?
  company             String?
  industry            String?
  city                String?         @default("Bangalore")
  purpose             String?
  agreedTerms         Boolean         @default(true) @map("agreed_terms")
  avatarUrl           String?         @map("avatar_url")
  bio                 String?
  isEmailVerified     Boolean         @default(false) @map("is_email_verified")
  emailOtp            String?         @map("email_otp")
  emailOtpExpires     DateTime?       @map("email_otp_expires")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  rides               Ride[]          @relation("CustomerRides")
  claims              Claim[]
  notifications       Notification[]
  paymentMethods      PaymentMethod[]
  rewards             Reward[]
  transactions        Transaction[]
  refundVouchers      RefundVoucher[]
  wallet              Wallet?
  communityPosts      CommunityRidePost[]
  sentConnections     UserConnection[] @relation("SentConnections")
  receivedConnections UserConnection[] @relation("ReceivedConnections")
  sentMessages        DirectMessage[]  @relation("SentDirectMessages")
  receivedMessages    DirectMessage[]  @relation("ReceivedDirectMessages")

  @@map("customers")
}

// =========================================================================
// RIDER & FLEET OPERATOR MODEL
// =========================================================================

model Rider {
  id                  String               @id
  name                String
  email               String               @unique
  phone               String
  password            String
  role                String               @default("rider")
  isAvailable         Boolean              @default(false) @map("is_available")
  vehicleType         String               @default("bike") @map("vehicle_type")
  currentLng          Float?               @map("current_lng")
  currentLat          Float?               @map("current_lat")
  heading             Float                @default(0)
  vehicle             Json?
  walletBalance       Decimal              @default(3450.00) @map("wallet_balance") @db.Decimal(12, 2)
  rating              Decimal              @default(4.90) @db.Decimal(3, 2)
  totalRides          Int                  @default(24) @map("total_rides")
  totalEarnings       Decimal              @default(3450.00) @map("total_earnings") @db.Decimal(12, 2)
  loyaltyPoints       Int                  @default(350) @map("loyalty_points")
  referralCode        String               @default("ALEX2025") @map("referral_code")
  documents           Json?
  preferences         Json?
  resetOtp            String?              @map("reset_otp")
  resetOtpExpires     DateTime?            @map("reset_otp_expires")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  rides               Ride[]               @relation("RiderRides")
  onboardingProfile   DriverOnboarding?
  vehicleInspections  VehicleInspection[]
  disbursements       Disbursement[]
  wallet              Wallet?
  settlementItems     SettlementItem[]

  @@map("riders")
}

// =========================================================================
// RIDE MODEL
// =========================================================================

model Ride {
  id                 String          @id
  customerId         String?         @map("customer_id")
  riderId            String?         @map("rider_id")
  pickupPlaceName    String?         @map("pickup_place_name")
  pickupAddress      String?         @map("pickup_address")
  pickupLat          Float?          @map("pickup_lat")
  pickupLng          Float?          @map("pickup_lng")
  dropPlaceName      String?         @map("drop_place_name")
  dropAddress        String?         @map("drop_address")
  dropLat            Float?          @map("drop_lat")
  dropLng            Float?          @map("drop_lng")
  status             String          @default("pending")
  vehicleType        String          @default("bike") @map("vehicle_type")
  fare               Decimal         @db.Decimal(10, 2)
  currency           String          @default("INR")
  distance           Float?
  duration           Float?
  polyline           String?
  otp                String?
  arrivedAt          DateTime?       @map("arrived_at")
  acceptedAt         DateTime?       @map("accepted_at")
  startedAt          DateTime?       @map("started_at")
  completedAt        DateTime?       @map("completed_at")
  waitCharges        Decimal         @default(0.00) @map("wait_charges") @db.Decimal(10, 2)
  cancellationReason String?         @map("cancellation_reason")
  cancelledBy        String?         @map("cancelled_by")
  idempotencyKey     String?         @map("idempotency_key")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  customer           Customer?       @relation("CustomerRides", fields: [customerId], references: [id])
  rider              Rider?          @relation("RiderRides", fields: [riderId], references: [id])
  claims             Claim[]
  supportTickets     SupportTicket[]

  @@index([customerId])
  @@index([riderId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("rides")
}

// =========================================================================
// ROLES & RBAC MODEL
// =========================================================================

model Role {
  id          String      @id
  name        String
  code        String      @unique
  description String?     @default("")
  status      String      @default("Active")
  isSystem    Boolean     @default(false) @map("is_system")
  permissions String[]
  dataAccess  Json?       @map("data_access")
  accessScope String      @default("All Resources") @map("access_scope")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  adminRoles  AdminRole[]
  auditLogs   AuditLog[]

  @@map("roles")
}

// =========================================================================
// ADMIN & STAFF USER MODEL
// =========================================================================

model Admin {
  id                         String                    @id
  name                       String
  email                      String                    @unique
  password                   String
  role                       String                    @default("admin")
  isActive                   Boolean                   @default(true) @map("is_active")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")

  adminRoles                 AdminRole[]
  initiatedLogs              AuditLog[]                @relation("AdminInitiator")
  targetedLogs               AuditLog[]                @relation("AdminTarget")

  // Role-specific assignments
  assignedTickets            SupportTicket[]           @relation("AssignedAgent")
  escalationsInitiated       SupportEscalation[]       @relation("EscalatedByAgent")
  escalationsReviewed        SupportEscalation[]       @relation("ReviewedBySupervisor")
  coachedDrivers             DriverOnboarding[]        @relation("AssignedFleetCoach")
  inspectedVehicles          VehicleInspection[]       @relation("InspectingCoach")
  surgeRules                 SurgeRule[]               @relation("ManagerSurgeRules")
  incentiveBroadcasts        DriverIncentiveBroadcast[] @relation("ManagerBroadcasts")
  authorizedPayoutBatches    PayoutBatch[]             @relation("AuthorizedPayoutBatches")
  executedDisbursements      Disbursement[]            @relation("ExecutedDisbursements")
  authorizedRefundVouchers   RefundVoucher[]           @relation("AuthorizedRefunds")
  authorizedSettlementBatches SettlementBatch[]        @relation("AuthorizedSettlementBatches")

  @@map("admins")
}

model AdminRole {
  adminId    String   @map("admin_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_roles")
}

model AuditLog {
  id            String   @id
  adminId       String   @map("admin_id")
  action        String
  roleId        String?  @map("role_id")
  targetAdminId String?  @map("target_admin_id")
  changes       Json?
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  admin         Admin    @relation("AdminInitiator", fields: [adminId], references: [id])
  role          Role?    @relation(fields: [roleId], references: [id])
  targetAdmin   Admin?   @relation("AdminTarget", fields: [targetAdminId], references: [id])

  @@map("audit_logs")
}

// =========================================================================
// ROLE 1 & 2: SUPPORT AGENT & HEAD OF SUPPORT MODELS
// =========================================================================

model SupportTicket {
  id                String             @id
  ticketNumber      String             @unique @map("ticket_number")
  userId            String?            @map("user_id")
  userType          String             @default("Customer") @map("user_type")
  userName          String             @map("user_name")
  userPhone         String             @map("user_phone")
  rideId            String?            @map("ride_id")
  category          String
  subject           String
  details           String
  priority          String             @default("medium") // low, medium, high, urgent
  status            String             @default("open")   // open, in_progress, escalated, resolved, closed
  assignedAgentId   String?            @map("assigned_agent_id")
  resolutionNote    String?            @map("resolution_note")
  refundAmount      Decimal?           @map("refund_amount") @db.Decimal(10, 2)
  resolvedAt        DateTime?          @map("resolved_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  assignedAgent     Admin?             @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  ride              Ride?              @relation(fields: [rideId], references: [id], onDelete: SetNull)
  messages          TicketMessage[]
  escalation        SupportEscalation?

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id
  ticketId   String        @map("ticket_id")
  senderId   String        @map("sender_id")
  senderName String        @map("sender_name")
  senderType String        @map("sender_type") // Agent, Customer, Rider, Supervisor
  message    String
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model SupportEscalation {
  id               String        @id
  ticketId         String        @unique @map("ticket_id")
  escalatedById    String        @map("escalated_by_id")
  reviewedById     String?       @map("reviewed_by_id")
  requestedAction  String        @map("requested_action")
  supervisorNotes  String?       @map("supervisor_notes")
  status           String        @default("pending_review") // pending_review, approved, dismissed
  approvedRefund   Decimal?      @map("approved_refund") @db.Decimal(10, 2)
  driverPenalty    Decimal?      @map("driver_penalty") @db.Decimal(10, 2)
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalatedBy      Admin         @relation("EscalatedByAgent", fields: [escalatedById], references: [id])
  reviewedBy       Admin?        @relation("ReviewedBySupervisor", fields: [reviewedById], references: [id])

  @@map("support_escalations")
}

// =========================================================================
// ROLE 4 & 5: FLEET COACH & HEAD OF FLEET COACH MODELS
// =========================================================================

model DriverOnboarding {
  id                       String              @id
  driverId                 String              @unique @map("driver_id")
  coachId                  String?             @map("coach_id")
  dlStatus                 String              @default("Pending") @map("dl_status") // Approved, Pending, Required
  rcStatus                 String              @default("Pending") @map("rc_status")
  aadharStatus             String              @default("Pending") @map("aadhar_status")
  policeVerificationStatus String              @default("Required") @map("police_verification_status")
  trainingStatus           String              @default("Not Started") @map("training_status") // Not Started, Module 1/4, Module 2/4, Module 3/4, Completed (100%)
  trainingScore            Int?                @default(0) @map("training_score")
  overallStatus            String              @default("pending_review") @map("overall_status") // pending_review, in_progress, approved, rejected
  coachNotes               String?             @map("coach_notes")
  approvedAt               DateTime?           @map("approved_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  driver                   Rider               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  coach                    Admin?              @relation("AssignedFleetCoach", fields: [coachId], references: [id], onDelete: SetNull)
  inspections              VehicleInspection[]

  @@map("driver_onboardings")
}

model VehicleInspection {
  id               String            @id
  onboardingId     String?           @map("onboarding_id")
  riderId          String            @map("rider_id")
  inspectorId      String            @map("inspector_id")
  vehiclePlate     String            @map("vehicle_plate")
  vehicleModel     String            @map("vehicle_model")
  vehicleType      String            @map("vehicle_type")
  odometerReading  Int?              @map("odometer_reading")
  brakesCondition  String            @default("Pass") @map("brakes_condition")
  tiresCondition   String            @default("Pass") @map("tires_condition")
  lightsCondition  String            @default("Pass") @map("lights_condition")
  insuranceValid   Boolean           @default(true) @map("insurance_valid")
  pollutionValid   Boolean           @default(true) @map("pollution_valid")
  inspectionPass   Boolean           @default(true) @map("inspection_pass")
  notes            String?
  inspectedAt      DateTime          @default(now()) @map("inspected_at")

  onboarding       DriverOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)
  rider            Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  inspector        Admin             @relation("InspectingCoach", fields: [inspectorId], references: [id])

  @@map("vehicle_inspections")
}

model FleetZone {
  id              String   @id
  name            String   @unique
  city            String   @default("Bangalore")
  targetDrivers   Int      @default(100) @map("target_drivers")
  activeDrivers   Int      @default(0) @map("active_drivers")
  complianceRate  Decimal  @default(98.0) @map("compliance_rate") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("fleet_zones")
}

// =========================================================================
// ROLE 6: OPERATIONS MANAGER MODELS
// =========================================================================

model CityZone {
  id               String      @id
  name             String      @unique
  city             String      @default("Bangalore")
  demandLevel      String      @default("Moderate") @map("demand_level") // Low, Moderate, High, Extreme
  activeDrivers    Int         @default(0) @map("active_drivers")
  pendingRiders    Int         @default(0) @map("pending_riders")
  surgeMultiplier  Decimal     @default(1.0) @map("surge_multiplier") @db.Decimal(3, 1)
  status           String      @default("normal") // normal, surge_active
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  surgeRules       SurgeRule[]

  @@map("city_zones")
}

model SurgeRule {
  id          String    @id
  zoneId      String    @map("zone_id")
  managerId   String    @map("manager_id")
  multiplier  Decimal   @db.Decimal(3, 1)
  reason      String
  isActive    Boolean   @default(true) @map("is_active")
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  createdAt   DateTime  @default(now()) @map("created_at")

  zone        CityZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  manager     Admin     @relation("ManagerSurgeRules", fields: [managerId], references: [id])

  @@map("surge_rules")
}

model DriverIncentiveBroadcast {
  id          String   @id
  managerId   String   @map("manager_id")
  title       String
  bonusAmount Decimal  @map("bonus_amount") @db.Decimal(10, 2)
  targetZone  String?  @map("target_zone")
  message     String
  status      String   @default("active")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  manager     Admin    @relation("ManagerBroadcasts", fields: [managerId], references: [id])

  @@map("driver_incentive_broadcasts")
}

// =========================================================================
// ROLE 7 & 8: FINANCE ADMIN & FINANCERS MODELS
// =========================================================================

model PayoutBatch {
  id                String         @id
  batchReference    String         @unique @map("batch_reference") // e.g. BATCH-2026-W42
  disbursementDate  DateTime       @map("disbursement_date")
  totalAmount       Decimal        @map("total_amount") @db.Decimal(12, 2)
  driverCount       Int            @map("driver_count")
  gatewayFee        Decimal        @default(0.00) @map("gateway_fee") @db.Decimal(10, 2)
  status            String         @default("pending_authorization") // pending_authorization, approved, processing, completed
  authorizedById    String?        @map("authorized_by_id")
  authorizedAt      DateTime?      @map("authorized_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  authorizedBy      Admin?         @relation("AuthorizedPayoutBatches", fields: [authorizedById], references: [id], onDelete: SetNull)
  disbursements     Disbursement[]

  @@map("payout_batches")
}

model Disbursement {
  id            String       @id
  payoutRef     String       @unique @map("payout_ref") // e.g. PAY-901
  batchId       String?      @map("batch_id")
  riderId       String       @map("rider_id")
  driverName    String       @map("driver_name")
  driverPhone   String       @map("driver_phone")
  amount        Decimal      @db.Decimal(12, 2)
  bankName      String       @map("bank_name")
  ifscCode      String       @map("ifsc_code")
  accountNumber String       @map("account_number")
  method        String       @default("IMPS")
  status        String       @default("pending") // pending, approved, processing, completed, failed
  failureReason String?      @map("failure_reason")
  executedById  String?      @map("executed_by_id")
  executedAt    DateTime?    @map("executed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  batch         PayoutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  rider         Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  executedBy    Admin?       @relation("ExecutedDisbursements", fields: [executedById], references: [id], onDelete: SetNull)

  @@map("disbursements")
}

model RefundVoucher {
  id             String    @id
  customerId     String    @map("customer_id")
  ticketId       String?   @map("ticket_id")
  amount         Decimal   @db.Decimal(10, 2)
  reason         String
  status         String    @default("issued") // issued, claimed, expired
  authorizedById String    @map("authorized_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorizedBy   Admin     @relation("AuthorizedRefunds", fields: [authorizedById], references: [id])

  @@map("refund_vouchers")
}

// =========================================================================
// LEGACY COMPATIBILITY MODELS (Claims, Notifications, Payments, Rewards)
// =========================================================================

model Claim {
  id          String    @id
  userId      String    @map("user_id")
  userModel   String    @default("Customer") @map("user_model")
  rideId      String?   @map("ride_id")
  type        String
  description String
  status      String    @default("open")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride        Ride?     @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@map("claims")
}

model Notification {
  id        String    @id
  userId    String    @map("user_id")
  userModel String    @default("Customer") @map("user_model")
  title     String
  body      String
  type      String    @default("system")
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  customer  Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentMethod {
  id            String    @id
  userId        String    @map("user_id")
  userModel     String    @default("Customer") @map("user_model")
  type          String
  provider      String
  last4         String?
  accountNumber String?   @map("account_number")
  ifscOrRouting String?   @map("ifsc_or_routing")
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer      Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Reward {
  id            String    @id
  userId        String    @map("user_id")
  userModel     String    @default("Customer") @map("user_model")
  type          String
  title         String
  description   String?   @default("")
  code          String?
  discountValue Decimal   @default(0.00) @map("discount_value") @db.Decimal(10, 2)
  progress      Decimal   @default(0.00) @db.Decimal(10, 2)
  target        Decimal   @default(0.00) @db.Decimal(10, 2)
  rewardAmount  Decimal   @default(0.00) @map("reward_amount") @db.Decimal(10, 2)
  validUntil    DateTime  @map("valid_until")
  isLocked      Boolean   @default(false) @map("is_locked")
  isUsed        Boolean   @default(false) @map("is_used")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer      Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

model Transaction {
  id          String    @id
  userId      String    @map("user_id")
  userModel   String    @default("Customer") @map("user_model")
  type        String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("INR")
  description String
  referenceId String?   @map("reference_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// =========================================================================
// RIDER & DRIVER WALLET, TRANSACTION LEDGER, AND RAZORPAY ORDERS
// =========================================================================

model Wallet {
  id            String              @id
  userId        String              @map("user_id")
  userType      String              @default("customer") @map("user_type") // "customer" | "rider"
  currency      String              @default("INR")
  balance       Decimal             @default(0.00) @db.Decimal(12, 2)
  lockedBalance Decimal             @default(0.00) @map("locked_balance") @db.Decimal(12, 2)
  status        String              @default("active") // active, suspended, frozen
  customerId    String?             @unique @map("customer_id")
  riderId       String?             @unique @map("rider_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rider         Rider?              @relation(fields: [riderId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  paymentOrders PaymentOrder[]

  @@unique([userId, userType])
  @@map("wallets")
}

model WalletTransaction {
  id             String    @id
  walletId       String    @map("wallet_id")
  type           String    // TOPUP, RIDE_FARE, REFUND, CASHBACK, PENALTY, SETTLEMENT_PAYOUT
  amount         Decimal   @db.Decimal(12, 2)
  direction      String    // CREDIT, DEBIT
  balanceBefore  Decimal   @map("balance_before") @db.Decimal(12, 2)
  balanceAfter   Decimal   @map("balance_after") @db.Decimal(12, 2)
  currency       String    @default("INR")
  status         String    @default("SUCCESS") // SUCCESS, PENDING, FAILED, REVERSED
  referenceId    String?   @map("reference_id") // order_id, ride_id, voucher_id, batch_id
  referenceType  String?   @map("reference_type") // PAYMENT_ORDER, RIDE, REFUND_VOUCHER, SETTLEMENT_ITEM
  description    String
  metadata       Json?
  failureReason  String?   @map("failure_reason")
  idempotencyKey String?   @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  wallet         Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model PaymentOrder {
  id                String    @id
  walletId          String    @map("wallet_id")
  userId            String    @map("user_id")
  userType          String    @default("customer") @map("user_type")
  orderId           String    @unique @map("order_id") // Razorpay order_id (e.g. order_xxx)
  amount            Decimal   @db.Decimal(12, 2) // In INR
  amountPaise       Int       @map("amount_paise") // In paise
  currency          String    @default("INR")
  status            String    @default("created") // created, attempted, paid, failed, cancelled
  receipt           String    @unique
  razorpayPaymentId String?   @unique @map("razorpay_payment_id")
  razorpaySignature String?   @map("razorpay_signature")
  idempotencyKey    String?   @unique @map("idempotency_key")
  errorCode         String?   @map("error_code")
  errorDescription  String?   @map("error_description")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  wallet            Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("payment_orders")
}

// =========================================================================
// AUTOMATED WEEKLY SETTLEMENT & RECONCILIATION MODELS
// =========================================================================

model SettlementBatch {
  id               String           @id
  batchReference   String           @unique @map("batch_reference") // e.g. SETTLE-2026-W43
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  periodTimezone   String           @default("Asia/Kolkata") @map("period_timezone")
  settlementType   String           @default("DRIVER_EARNINGS") @map("settlement_type") // DRIVER_EARNINGS, PLATFORM_RECONCILIATION
  totalRides       Int              @default(0) @map("total_rides")
  grossFare        Decimal          @default(0.00) @map("gross_fare") @db.Decimal(12, 2)
  platformFee      Decimal          @default(0.00) @map("platform_fee") @db.Decimal(12, 2)
  netPayable       Decimal          @default(0.00) @map("net_payable") @db.Decimal(12, 2)
  beneficiaryCount Int              @default(0) @map("beneficiary_count")
  status           String           @default("CALCULATED") // CALCULATED, PENDING_APPROVAL, APPROVED, PROCESSING, COMPLETED, FAILED
  isDryRun         Boolean          @default(true) @map("is_dry_run")
  calculatedAt     DateTime         @default(now()) @map("calculated_at")
  authorizedById   String?          @map("authorized_by_id")
  authorizedAt     DateTime?        @map("authorized_at")
  executedAt       DateTime?        @map("executed_at")
  failureReason    String?          @map("failure_reason")
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  authorizedBy     Admin?           @relation("AuthorizedSettlementBatches", fields: [authorizedById], references: [id], onDelete: SetNull)
  items            SettlementItem[]

  @@map("settlement_batches")
}

model SettlementItem {
  id                String          @id
  batchId           String          @map("batch_id")
  beneficiaryId     String          @map("beneficiary_id") // Rider / Driver ID
  beneficiaryName   String          @map("beneficiary_name")
  beneficiaryPhone  String          @map("beneficiary_phone")
  bankAccountNumber String?         @map("bank_account_number")
  ifscCode          String?         @map("ifsc_code")
  rideCount         Int             @default(0) @map("ride_count")
  grossAmount       Decimal         @map("gross_amount") @db.Decimal(12, 2)
  deductions        Decimal         @default(0.00) @db.Decimal(12, 2)
  incentives        Decimal         @default(0.00) @db.Decimal(12, 2)
  netAmount         Decimal         @map("net_amount") @db.Decimal(12, 2)
  status            String          @default("PENDING") // PENDING, HELD, APPROVED, PROCESSING, SUCCESS, FAILED
  payoutRef         String?         @unique @map("payout_ref")
  failureReason     String?         @map("failure_reason")
  processedAt       DateTime?       @map("processed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  batch             SettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rider             Rider           @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([batchId, beneficiaryId])
  @@map("settlement_items")
}

model IdempotencyRecord {
  id           String   @id
  key          String   @unique
  endpoint     String
  requestHash  String?  @map("request_hash")
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([key, expiresAt])
  @@map("idempotency_records")
}

// =========================================================================
// COMMUNITY RIDE-SHARING, PROFILES & MESSAGING
// =========================================================================

model CommunityRidePost {
  id               String   @id
  authorId         String   @map("author_id")
  authorName       String   @map("author_name")
  authorPhone      String?  @map("author_phone")
  authorProfession String?  @map("author_profession")
  authorCompany    String?  @map("author_company")
  authorAvatar     String?  @map("author_avatar")
  city             String   @default("Bangalore")
  fromLocation     String   @map("from_location")
  toLocation       String   @map("to_location")
  departureTime    String   @map("departure_time")
  returnTime       String?  @map("return_time")
  days             String   @default("Mon-Fri")
  vehicleType      String   @default("Car") @map("vehicle_type")
  seatsAvailable   Int      @default(3) @map("seats_available")
  fuelShareCost    Decimal? @map("fuel_share_cost") @db.Decimal(10, 2)
  preferences      String?
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  author           Customer @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([city, status])
  @@index([authorId])
  @@map("community_ride_posts")
}

model UserConnection {
  id          String   @id
  requesterId String   @map("requester_id")
  recipientId String   @map("recipient_id")
  status      String   @default("connected")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester   Customer @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   Customer @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@map("user_connections")
}

model DirectMessage {
  id         String   @id
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender     Customer @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   Customer @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@map("direct_messages")
}


