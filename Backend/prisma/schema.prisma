generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                  String          @id
  name                String
  email               String          @unique
  phone               String
  password            String?
  role                String          @default("customer")
  walletBalance       Decimal         @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  coinBalance         Int             @default(0) @map("coin_balance")
  powerPassActive     Boolean         @default(false) @map("power_pass_active")
  powerPassPlan       String?         @map("power_pass_plan")
  powerPassValidUntil DateTime?       @map("power_pass_valid_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  rides               Ride[]          @relation("CustomerRides")
  claims              Claim[]
  notifications       Notification[]
  paymentMethods      PaymentMethod[]
  rewards             Reward[]
  transactions        Transaction[]

  @@map("customers")
}

model Rider {
  id               String    @id
  name             String
  email            String    @unique
  phone            String
  password         String
  role             String    @default("rider")
  isAvailable      Boolean   @default(false) @map("is_available")
  vehicleType      String    @default("bike") @map("vehicle_type")
  currentLng       Float?    @map("current_lng")
  currentLat       Float?    @map("current_lat")
  heading          Float     @default(0)
  vehicle          Json?
  walletBalance    Decimal   @default(3450.00) @map("wallet_balance") @db.Decimal(12, 2)
  rating           Decimal   @default(4.90) @db.Decimal(3, 2)
  totalRides       Int       @default(24) @map("total_rides")
  totalEarnings    Decimal   @default(3450.00) @map("total_earnings") @db.Decimal(12, 2)
  loyaltyPoints    Int       @default(350) @map("loyalty_points")
  referralCode     String    @default("ALEX2025") @map("referral_code")
  documents        Json?
  preferences      Json?
  resetOtp         String?   @map("reset_otp")
  resetOtpExpires  DateTime? @map("reset_otp_expires")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  rides            Ride[]    @relation("RiderRides")

  @@map("riders")
}

model Ride {
  id                 String    @id
  customerId         String?   @map("customer_id")
  riderId            String?   @map("rider_id")
  pickupAddress      String?   @map("pickup_address")
  pickupLat          Float?    @map("pickup_lat")
  pickupLng          Float?    @map("pickup_lng")
  dropAddress        String?   @map("drop_address")
  dropLat            Float?    @map("drop_lat")
  dropLng            Float?    @map("drop_lng")
  status             String    @default("pending")
  vehicleType        String    @default("bike") @map("vehicle_type")
  fare               Decimal   @db.Decimal(10, 2)
  distance           Float?
  duration           Float?
  polyline           String?
  otp                String?
  arrivedAt          DateTime? @map("arrived_at")
  waitCharges        Decimal   @default(0.00) @map("wait_charges") @db.Decimal(10, 2)
  cancellationReason String?   @map("cancellation_reason")
  cancelledBy        String?   @map("cancelled_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  customer           Customer? @relation("CustomerRides", fields: [customerId], references: [id])
  rider              Rider?    @relation("RiderRides", fields: [riderId], references: [id])
  claims             Claim[]

  @@map("rides")
}

model Role {
  id          String      @id
  name        String
  code        String      @unique
  description String?     @default("")
  status      String      @default("Active")
  isSystem    Boolean     @default(false) @map("is_system")
  permissions String[]
  dataAccess  Json?       @map("data_access")
  accessScope String      @default("All Resources") @map("access_scope")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  adminRoles  AdminRole[]
  auditLogs   AuditLog[]

  @@map("roles")
}

model Admin {
  id            String      @id
  name          String
  email         String      @unique
  password      String
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  adminRoles    AdminRole[]
  initiatedLogs AuditLog[]  @relation("AdminInitiator")
  targetedLogs  AuditLog[]  @relation("AdminTarget")

  @@map("admins")
}

model AdminRole {
  adminId    String   @map("admin_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_roles")
}

model AuditLog {
  id            String   @id
  adminId       String   @map("admin_id")
  action        String
  roleId        String?  @map("role_id")
  targetAdminId String?  @map("target_admin_id")
  changes       Json?
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  admin         Admin    @relation("AdminInitiator", fields: [adminId], references: [id])
  role          Role?    @relation(fields: [roleId], references: [id])
  targetAdmin   Admin?   @relation("AdminTarget", fields: [targetAdminId], references: [id])

  @@map("audit_logs")
}

model Claim {
  id          String   @id
  userId      String   @map("user_id")
  userModel   String   @default("Customer") @map("user_model")
  rideId      String?  @map("ride_id")
  type        String
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride        Ride?     @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@map("claims")
}

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  userModel String   @default("Customer") @map("user_model")
  title     String
  body      String
  type      String   @default("system")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer  Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PaymentMethod {
  id            String   @id
  userId        String   @map("user_id")
  userModel     String   @default("Customer") @map("user_model")
  type          String
  provider      String
  last4         String?
  accountNumber String?  @map("account_number")
  ifscOrRouting String?  @map("ifsc_or_routing")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Reward {
  id            String   @id
  userId        String   @map("user_id")
  userModel     String   @default("Customer") @map("user_model")
  type          String
  title         String
  description   String?  @default("")
  code          String?
  discountValue Decimal  @default(0.00) @map("discount_value") @db.Decimal(10, 2)
  progress      Decimal  @default(0.00) @db.Decimal(10, 2)
  target        Decimal  @default(0.00) @db.Decimal(10, 2)
  rewardAmount  Decimal  @default(0.00) @map("reward_amount") @db.Decimal(10, 2)
  validUntil    DateTime @map("valid_until")
  isLocked      Boolean  @default(false) @map("is_locked")
  isUsed        Boolean  @default(false) @map("is_used")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

model Transaction {
  id          String   @id
  userId      String   @map("user_id")
  userModel   String   @default("Customer") @map("user_model")
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  description String
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}
